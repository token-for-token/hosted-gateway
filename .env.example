# --- Required ---

# Postgres (Prisma)
DATABASE_URL=postgresql://hosted:hosted@localhost:5432/hosted_gateway?schema=public

# Redis (BullMQ + locks + nonce)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
GOOGLE_OAUTH_CLIENT_ID=

# Operator wallet (the ONLY on-chain identity)
OPERATOR_PRIVATE_KEY=0x...
GNOSIS_RPC_URL=https://rpc.gnosischain.com

# T4T protocol contract addresses (Gnosis mainnet — managed by the t4t repo).
# These are the canonical live deployment; override only when pointing at a
# private fork or testnet (Chiado).
REGISTRY_ADDRESS=0xf81121AAbc2F7261224BaDd0Ed871711e6D1371E
ESCROW_ADDRESS=0x34Db8E014E71928f17E23eC1272B602582222c9c
XBZZ_ADDRESS=0xdBF3Ea6F5beE45c02255B2c26a16F300502F68da

# Bee node (operator-owned, single postage batch)
BEE_API_URL=http://localhost:1633
BEE_POSTAGE_BATCH_ID=
BEE_STAMP_MANAGE=true
BEE_STAMP_LABEL=hosted-gateway
BEE_STAMP_TTL_DAYS=30

# Pricing
MARKUP_BPS=2000              # 20% operator markup on xBZZ cost
WELCOME_XBZZ_WEI=50000000000000000000  # 50 xBZZ in wei

# Concurrency
MAX_CONCURRENT_JOBS=200

# Server
HOSTED_GATEWAY_PORT=8080
LOG_LEVEL=info

# --- Phase 2 (Stripe) — leave blank in v1 ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
