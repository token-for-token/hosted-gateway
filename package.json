{
  "name": "hosted-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted multi-tenant frontend for the Token4Token inference network. One operator wallet; xBZZ-denominated off-chain ledger.",
  "scripts": {
    "dev:api": "bun run --watch src/api.ts",
    "dev:worker": "bun run --watch src/worker.ts",
    "start:api": "bun run src/api.ts",
    "start:worker": "bun run src/worker.ts",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:migrate": "bunx prisma migrate deploy",
    "db:seed": "bun run prisma/seed/index.ts",
    "test:e2e": "bun test --preload ./test/setup.ts ./test/**/*.e2e-spec.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "//comment": "Prisma 7 reads its config from prisma.config.ts at the package root, not from package.json#prisma.",
  "dependencies": {
    "@elysiajs/bearer": "^1.2.0",
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/swagger": "^1.2.0",
    "@ethersphere/bee-js": "^11.0.0",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "elysia": "^1.2.25",
    "google-auth-library": "^9.15.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "bun-types": "latest",
    "prisma": "^7.0.0",
    "typescript": "^5.7"
  },
  "//prisma-config": "Prisma 7 — see prisma.config.ts"
}
